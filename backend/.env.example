# Copy to .env and fill in. Provided by the challenge.
# (Voice and model live in the agent JSON, e.g. agents/scheduler.json, not here.)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Optional: TypeSafe Jev, used by the 'hybrid' (default), 'jev' and 'cascade' catalog matchers.
# Without it they fall back to the local fuzzy matcher (flagged at startup and in the builder).
TYPESAFE_API_KEY=
